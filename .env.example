# Optional. Copy to .env; the app and Docker Compose read it automatically.
# Variables already exported in your shell take precedence over this file.

# Optional server-only Gemini key. Leave blank for the no-key fixture workflow.
# The model is fixed to gemini-3.5-flash-lite. Billing and quota are governed
# by your own Google AI Studio project, not by this app.
GEMINI_API_KEY=

# Demo-only signing material; never use production credentials.
DEMO_SIGNING_KEY=clinic-synthetic-local-only

# Loopback ports (defaults shown). Change them if another app already uses one.
# The UI port also sets the only origin the API accepts for mutations.
# CLINIC_UI_PORT=5174
# CLINIC_API_PORT=8011
# CLINIC_RECEIVER_PORT=9011
# CLINIC_MONGO_PORT=27018
# CLINIC_REDIS_PORT=6381

# Optional explicit connection strings; by default they follow the ports above.
# MONGO_URL=mongodb://127.0.0.1:27018
# REDIS_URL=redis://127.0.0.1:6381
